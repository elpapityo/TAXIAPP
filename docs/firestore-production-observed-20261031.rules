rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 認証・管理者判定
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    // 管理者権限はFirebase Consoleまたは
    // 信頼済みサーバーからのみ設定する
    function isAdmin() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.enabled == true;
    }

    // ==========================================
    // 管理者情報
    // ==========================================

    match /admins/{uid} {

      allow get: if signedIn() &&
        (request.auth.uid == uid || isAdmin());

      allow list: if isAdmin();

      // 管理者権限の自己取得は禁止
      allow create, update, delete: if false;
    }

    // ==========================================
    // 一般利用者登録
    // Google認証後の自動登録
    // オプチャネームを同時保存
    // ==========================================

    match /users/{uid} {

      // 本人または管理者だけが登録情報を閲覧
      allow get: if signedIn() &&
        (request.auth.uid == uid || isAdmin());

      // 利用者一覧は管理者のみ
      allow list: if isAdmin();

      // 本人による初回登録のみ許可
      allow create: if signedIn() &&

        // 他人のUIDへの登録禁止
        request.auth.uid == uid &&

        // Googleアカウント認証が必須
        request.auth.token.firebase.sign_in_provider
          == 'google.com' &&

        // 確認済みメールアドレスが必須
        request.auth.token.email_verified == true &&

        // 登録可能な項目を限定
        request.resource.data.keys().hasOnly([
          'status',
          'registeredAt',
          'openChatName'
        ]) &&

        request.resource.data.keys().hasAll([
          'status',
          'registeredAt',
          'openChatName'
        ]) &&

        // オプチャネーム必須
        request.resource.data.openChatName is string &&
        request.resource.data.openChatName.size() >= 1 &&
        request.resource.data.openChatName.size() <= 32 &&

        // 空白だけの名前は拒否
        request.resource.data.openChatName.matches(
          '.*\\S.*'
        ) &&

        // 一般利用者として有効化
        request.resource.data.status == 'active' &&

        // 登録日時はサーバー時刻
        request.resource.data.registeredAt
          == request.time;

      // 既存ユーザーの自己変更・自己復活は禁止
      allow update, delete: if false;
    }

    // ==========================================
    // 有効な利用者の判定
    // ==========================================

    function activeUser(uid) {
      return exists(
        /databases/$(database)/documents/users/$(uid)
      ) &&
        get(
          /databases/$(database)/documents/users/$(uid)
        ).data.status == 'active';
    }

    // 本人UIDだけを許可
    function ownerEnabled(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        (isAdmin() || activeUser(uid));
    }

    // ==========================================
    // 操作端末のセッション管理
    // ==========================================

    match /deviceSessions/{uid} {

      allow get: if ownerEnabled(uid);

      allow list, delete: if false;

      allow create, update: if ownerEnabled(uid) &&

        request.resource.data.keys().hasOnly([
          'sessionId',
          'updatedAt'
        ]) &&

        request.resource.data.keys().hasAll([
          'sessionId',
          'updatedAt'
        ]) &&

        request.resource.data.sessionId is string &&

        request.resource.data.sessionId.size() >= 32 &&

        request.resource.data.sessionId.size() <= 128 &&

        request.resource.data.updatedAt == request.time;
    }

    // ==========================================
    // 現在の操作端末の確認
    // ==========================================

    function isCurrentEditor(uid) {
      return exists(
        /databases/$(database)/documents/deviceSessions/$(uid)
      ) &&
        request.resource.data.writerSessionId ==
          get(
            /databases/$(database)/documents/deviceSessions/$(uid)
          ).data.sessionId;
    }

    // ==========================================
    // 利用者別設定
    // ==========================================

    match /accountSettings/{uid} {

      allow get: if ownerEnabled(uid);

      allow list, delete: if false;

      allow create, update: if ownerEnabled(uid) &&
        isCurrentEditor(uid) &&

        request.resource.data.keys().hasOnly([
          'format',
          'schemaVersion',
          'prefs',
          'updatedAt',
          'writerSessionId'
        ]) &&

        request.resource.data.keys().hasAll([
          'format',
          'schemaVersion',
          'prefs',
          'updatedAt',
          'writerSessionId'
        ]) &&

        request.resource.data.format ==
          'TAXIAPP_ACCOUNT_SETTINGS_V1' &&

        request.resource.data.schemaVersion == 1 &&

        request.resource.data.prefs is map &&

        request.resource.data.writerSessionId is string &&

        request.resource.data.updatedAt == request.time;
    }

    // ==========================================
    // 本人UID別Firestore日報原本
    // ==========================================

    function validPrivateDuty(uid, shiftId) {
      return ownerEnabled(uid) &&

        request.resource.data.keys().hasOnly([
          'format',
          'revision',
          'shift',
          'writerSessionId',
          'updatedAt',
          'trashed'
        ]) &&

        request.resource.data.keys().hasAll([
          'format',
          'revision',
          'shift',
          'writerSessionId',
          'updatedAt'
        ]) &&

        request.resource.data.format ==
          'TAXIAPP_PRIVATE_SHIFT_V1' &&

        request.resource.data.revision is int &&

        request.resource.data.revision > 0 &&

        request.resource.data.shift is map &&

        request.resource.data.shift.id == shiftId &&

        request.resource.data.shift.records is list &&

        request.resource.data.shift.records.size() <= 60 &&

        request.resource.data.shift.settings is map &&

        request.resource.data.writerSessionId is string &&

        (
          !request.resource.data.keys().hasAny([
            'trashed'
          ]) ||
          request.resource.data.trashed is bool
        ) &&

        request.resource.data.updatedAt == request.time &&

        isCurrentEditor(uid);
    }

    // ==========================================
    // 日報原本：利用者ごとに完全分離
    // ==========================================

    match /privateDuties/{uid}/shifts/{shiftId} {

      // 本人だけが取得・一覧参照可能
      allow get, list: if ownerEnabled(uid);

      // 新規保存：更新番号は1
      allow create: if validPrivateDuty(uid, shiftId) &&
        request.resource.data.revision == 1;

      // 更新：更新番号を必ず1増やす
      allow update: if validPrivateDuty(uid, shiftId) &&

        resource.data.revision is int &&

        request.resource.data.revision ==
          resource.data.revision + 1;

      // 日報原本の直接削除は禁止
      allow delete: if false;
    }

    // ==========================================
    // 未承認のデータ領域はアクセス禁止
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
