// This fragment belongs INSIDE service cloud.firestore /databases/{database}/documents.
// NOT deployed. Uses existing signedIn(), isAdmin(), activeUser(), ownerEnabled().
function gpsViewerEnabled() {
  return signedIn() && (isAdmin() || activeUser(request.auth.uid));
}
match /gpsSharePrefs/{uid} {
  allow get: if ownerEnabled(uid);
  allow list, delete: if false;
  allow create, update: if ownerEnabled(uid) &&
    request.resource.data.keys().hasOnly(['public','updatedAt']) &&
    request.resource.data.keys().hasAll(['public','updatedAt']) &&
    request.resource.data.public is bool &&
    request.resource.data.updatedAt == request.time;
}
match /gpsPresence/{uid} {
  // Server data authorization; nonpublic markers are hidden from admins too.
  allow get, list: if gpsViewerEnabled() &&
    (request.auth.uid == uid ||
      (resource.data.public == true && resource.data.onDuty == true));
  allow create, update: if ownerEnabled(uid) &&
    request.resource.data.keys().hasOnly([
      'public','onDuty','status','name','lat','lon','accuracy','speed',
      'heading','shiftId','capturedAtMs','updatedAt'
    ]) &&
    request.resource.data.keys().hasAll([
      'public','onDuty','status','name','lat','lon','accuracy','speed',
      'heading','shiftId','capturedAtMs','updatedAt'
    ]) &&
    request.resource.data.public is bool &&
    request.resource.data.onDuty is bool &&
    request.resource.data.name is string &&
    request.resource.data.name.size() >= 1 &&
    request.resource.data.name.size() <= 80 &&
    request.resource.data.updatedAt == request.time &&
    (
      (request.resource.data.public == true &&
       request.resource.data.onDuty == true &&
       request.resource.data.status in ['空車','迎車','実車','支払い','待機'] &&
       request.resource.data.shiftId is string &&
       request.resource.data.shiftId.matches('^shift-[0-9]+(-[a-zA-Z0-9]+)?$') &&
       request.resource.data.lat is number &&
       request.resource.data.lon is number &&
       request.resource.data.lat >= -90 &&
       request.resource.data.lat <= 90 &&
       request.resource.data.lon >= -180 &&
       request.resource.data.lon <= 180 &&
       request.resource.data.accuracy is number &&
       request.resource.data.accuracy >= 0 &&
       request.resource.data.capturedAtMs is int &&
       request.resource.data.capturedAtMs > 0 &&
       (request.resource.data.speed == null ||
        (request.resource.data.speed is number && request.resource.data.speed >= 0)) &&
       (request.resource.data.heading == null ||
        (request.resource.data.heading is number &&
         request.resource.data.heading >= 0 &&
         request.resource.data.heading < 360)))
      ||
      (request.resource.data.public == false &&
       request.resource.data.onDuty == false &&
       request.resource.data.lat == null &&
       request.resource.data.lon == null &&
       request.resource.data.accuracy == null &&
       request.resource.data.speed == null &&
       request.resource.data.heading == null &&
       request.resource.data.shiftId == '' &&
       request.resource.data.capturedAtMs == null)
    );
  allow delete: if false;
}
// NOTE: On-duty confirmation is currently client-side only, not server verified.
// Rules are an unapproved draft and must not be deployed without authorization.
